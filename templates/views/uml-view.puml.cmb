<%
;;;;
;;;; Template for a PlantUML diagram of the UML Views
;;;; (code views, state machine views and use case views)
;;;;
;;;; The rendering of the single elements is implemented in the
;;;; lib.plantuml.uml namespace by the multimethod render-uml-element,
;;;; which can be extended or overridden to customize the diagram.
;;;;
;;;; config:
;;;;  :per-element true
;;;;  :id-as-name  true
;;;;
(require '[lib.plantuml.uml :as uml])
%><%= (str/join "\n" (uml/render-uml-view model e)) %>

' (generated by Overarch with template <%= (:template ctx) %>)
