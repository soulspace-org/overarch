%><!-- PA-END(ArchitectureConstraints1) -->

<%
  (when (seq architecture-constraints)
%>
### Constraints
<%=
    (md/node-description-table e :constraint architecture-constraints))
%>

<!-- PA-BEGIN(ArchitectureConstraints2) -->
<%= (get protected-areas "ArchitectureConstraints2" "")
%><!-- PA-END(ArchitectureConstraints2) -->

<%
) ; end of let
%>
