<%
;;;;
;;;; Markdown Arc42 Documentation Template for the Architecture Constraints
;;;;

(require '[lib.text :as t])
(require '[lib.markdown :as md])

(let [architecture-constraints (m/select-model-elements model {:el :constraint})]


%># Architecture Constraints

